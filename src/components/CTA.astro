---
// Single CTA: email (zero new tooling, per BO-SMC-WEBSITE-V1 defaults ruling).
// On Cloudflare Pages, Scrape Shield email obfuscation protects this mailto.
const email = 'smc@ingeniumvector.com';
---
<section class="section cta" id="contact" aria-labelledby="cta-h">
  <div class="wrap cta__inner">
    <h2 id="cta-h">Have something that should run itself?</h2>
    <p class="lede muted">
      Tell me what is eating your team's time. If it can be automated, I will tell you straight.
    </p>
    <p>
      <a class="btn btn--primary" href={`mailto:${email}`}>Email me</a>
    </p>
  </div>
</section>

<style>
  .cta__inner { text-align: center; display: grid; gap: 0.75rem; justify-items: center; }
</style>
